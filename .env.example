# ═══════════════════════════════════════════
# WebGrade Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in your keys

# ── eBay API (Browse API) ──
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_ENABLED=true

# ── openFDA ──
# Optional: works without key at lower rate limits
OPENFDA_API_KEY=

# ── Currency Conversion ──
# Optional: uses free fallback if not set
CURRENCY_API_KEY=

# ── Server ──
PORT=3001
NODE_ENV=development

# ── Frontend URL (for CORS in production) ──
FRONTEND_URL=http://localhost:5173
